    {
        "id": "5350f2a3584703a3",
        "type": "function",
        "z": "37ad7ff4acb2cba6",
        "name": "select ouvertes",
        "func": "const pipeline = [\n    {\n        $match: {\n            statut: \"ouverte\"\n        }\n    },\n    {\n        $lookup: {\n            from: \"clients\",\n            localField: \"clientId\",\n            foreignField: \"_id\",\n            as: \"client\"\n        }\n    },\n    {\n        $unwind: \"$client\"\n    },\n    {\n        $project: {\n            _id: 1,\n            tableNumero: 1,\n            dateArrivee: 1,\n            statut: 1,\n            clientNom: \"$client.nom\",\n            clientPrenom: \"$client.prenom\"\n        }\n    }\n];\n\nmsg.payload = [pipeline];\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 560,
        "y": 460,
