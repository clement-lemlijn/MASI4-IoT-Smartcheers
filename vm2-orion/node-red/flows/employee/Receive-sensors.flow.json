  {
    "id": "3c967559a74daae2",
    "type": "function",
    "z": "77d61a7c1ec3d7c7",
    "name": "function 31",
    "func": "// Conversion du payload MQTT\nlet data = msg.payload.toString().trim();\n\n// Device:esp32h2-102,Temp:22.0,Hum:50.0,Son:705\n\nlet sensor = {};\ndata.split(\",\").forEach(part => {\n    let [key, value] = part.split(\":\");\n    if (!key || !value) {\n        return;\n    }\n    key = key.trim();\n    value = value.trim();\n    switch (key) {\n\n        case \"Device\":\n            sensor.deviceId = value;\n            break;\n\n        case \"Temp\":\n            sensor.temperature = Number(value);\n            break;\n\n        case \"Hum\":\n            sensor.humidity = Number(value);\n            break;\n\n        case \"Son\":\n            sensor.sound = Number(value);\n            break;\n    }\n});\n\n// Ajout date/heure\nlet now = new Date();\nsensor.timestamp = now;\n\n// Optionnel : format lisible\nsensor.date = now.toISOString();\n\n// Vérification\nif (!sensor.deviceId) {\n    node.error(\"Message capteur invalide : \" + data);\n    return null;\n}\n\n\n// Envoi vers MongoDB\nmsg.payload = sensor;\n\nreturn msg;",
