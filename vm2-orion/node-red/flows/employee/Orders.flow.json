    {
        "id": "937391a3c6204f44",
        "type": "function",
        "z": "5472442e8b1089cc",
        "name": "function 3",
        "func": "const pipeline = [\n    {\n        $match: {\n            statut: \"en_attente\"\n        }\n    },\n    {\n        $lookup: {\n            from: \"visites\",\n            localField: \"visiteId\",\n            foreignField: \"_id\",\n            as: \"visite\"\n        }\n    },\n    {\n        $unwind: \"$visite\"\n    },\n    {\n        $project: {\n            _id: 1,\n            dateCommande: 1,\n            statut: 1,\n            montantTotal: 1,\n            lignes: 1,\n            tableNumero: \"$visite.tableNumero\"\n        }\n    }\n];\n\nmsg.payload = [pipeline];\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 480,
        "wires": [
            [
                "557e385b18e9d899"
            ]
        ]
    },
    {
        "id": "45cb17088028f082",
        "type": "function",
        "z": "5472442e8b1089cc",
        "name": "function 12",
        "func": "msg.payload = msg.payload.map(commande => {\n\n    // const date = new Date(commande.dateCommande)\n    //     .toLocaleString(\"fr-BE\", {\n    //         day:\"2-digit\",\n    //         month:\"2-digit\",\n    //         hour:\"2-digit\",\n    //         minute:\"2-digit\"\n    //     });\n\n    const date = new Date(commande.dateCommande)\n        .toLocaleString(\"fr-BE\", {\n            hour: \"2-digit\",\n            minute: \"2-digit\"\n        });\n\n    const items = commande.lignes.reduce(\n        (sum,l) => sum + l.quantite,\n        0\n    );\n\n    commande.affichage =\n        `${date} - ${items} article(s) - Table ${commande.tableNumero}`;\n\n    return commande;\n\n});\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 750,
        "y": 480,
        "wires": [
            [
                "6b6aaba786cc421f"
            ]
        ]
    },
    {
        "id": "6b6aaba786cc421f",
        "type": "ui_template",
        "z": "5472442e8b1089cc",
        "group": "bf930e9b68230c0c",
        "name": "",
        "order": 1,
        "width": 0,
        "height": 0,
        "format": "<div ng-if=\"msg.payload.length\">\n\n    <div class=\"command-card\" ng-repeat=\"commande in msg.payload\">\n        <span class=\"table\">\n            {{commande.affichage}}\n        </span>\n    </div>\n\n</div>\n\n<div ng-if=\"!msg.payload.length\" class=\"empty\">\n    Aucune visite.\n</div>\n\n<style>\n    .command-card {\n        background: var(--nr-dashboard-cardColor);\n        color: var(--nr-dashboard-textColor);\n        border-radius: 10px;\n        padding: 14px;\n        margin-bottom: 12px;\n        border-left: 4px solid #4caf50;\n    }\n\n    .header {\n        display: flex;\n        justify-content: space-between;\n        align-items: center;\n        margin-bottom: 10px;\n        font-weight: bold;\n    }\n\n    .table {\n        font-size: 18px;\n    }\n\n    .status {\n        background: #4caf50;\n        color: white;\n        padding: 3px 10px;\n        border-radius: 20px;\n        font-size: 12px;\n    }\n\n    .line {\n        display: flex;\n        justify-content: space-between;\n        margin: 6px 0;\n        font-size: 14px;\n        word-break: break-all;\n    }\n\n    .empty {\n        text-align: center;\n        color: #888;\n        padding: 20px;\n    }\n</style>",
        "storeOutMessages": true,
        "fwdInMessages": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "x": 940,
        "y": 600,
