    {
        "id": "87499acb18813544",
        "type": "function",
        "z": "5a5712cb8a4e9fe2",
        "name": "function 12",
        "func": "msg.payload = \"\";\nconst pipeline = [\n    {\n        $match: {\n            statut: \"en_attente\"\n        }\n    },\n    {\n        $lookup: {\n            from: \"visites\",\n            localField: \"visiteId\",\n            foreignField: \"_id\",\n            as: \"visite\"\n        }\n    },\n    {\n        $unwind: \"$visite\"\n    },\n    {\n        $project: {\n            _id: 1,\n            dateCommande: 1,\n            statut: 1,\n            montantTotal: 1,\n            lignes: 1,\n            tableNumero: \"$visite.tableNumero\"\n        }\n    }\n];\n\nmsg.payload = [pipeline];\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 450,
        "y": 420,
        "wires": [
            [
                "855a4f5e8e6e3111"
            ]
        ]
    },
    {
        "id": "bc5427385503ea66",
        "type": "function",
        "z": "5a5712cb8a4e9fe2",
        "name": "function 13",
        "func": "msg.payload = msg.payload.map(commande => {\n\n    // const date = new Date(commande.dateCommande)\n    //     .toLocaleString(\"fr-BE\", {\n    //         day:\"2-digit\",\n    //         month:\"2-digit\",\n    //         hour:\"2-digit\",\n    //         minute:\"2-digit\"\n    //     });\n\n    const date = new Date(commande.dateCommande)\n        .toLocaleString(\"fr-BE\", {\n            hour: \"2-digit\",\n            minute: \"2-digit\"\n        });\n\n    const items = commande.lignes.reduce(\n        (sum,l) => sum + l.quantite,\n        0\n    );\n\n    commande.affichage =\n        `${date} - ${items} article(s) - Table ${commande.tableNumero}`;\n\n    return commande;\n\n});\n\nmsg.options = msg.payload.map(commande => {\n    return { [commande.affichage]: commande._id };\n});\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 800,
