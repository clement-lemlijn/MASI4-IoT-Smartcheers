    {
        "id": "35ab1405811d0af1",
        "type": "ui_template",
        "z": "bb678ccee4044b0b",
        "group": "4ec9668789d29416",
        "name": "visit list",
        "order": 0,
        "width": 0,
        "height": 0,
        "format": "    <div ng-if=\"msg.payload.length\">\n        \n        <div class=\"visit-card\" ng-repeat=\"visite in msg.payload\">\n            <div class=\"header\">\n                <span class=\"table\">Table {{visite.tableNumero}}</span>\n                <span class=\"status\">{{visite.statut}}</span>\n            </div>\n    \n            <div class=\"line\">\n                <strong>Badge</strong>\n                <span>{{visite.badge.comment}}</span>\n            </div>\n    \n            <div class=\"line\">\n                <strong>Client</strong>\n                <span>{{visite.client.prenom}} {{visite.client.nom}}</span>\n            </div>\n    \n            <div class=\"line\">\n                <strong>Arrivée</strong>\n                <span>{{visite.dateArrivee | date:'dd/MM/yyyy HH:mm:ss'}}</span>\n            </div>\n    \n            <div class=\"line\">\n                <strong>Total</strong>\n                <span>{{visite.montantTotalVisite}} €</span>\n            </div>\n    \n        </div>\n    \n    </div>\n    \n    <div ng-if=\"!msg.payload.length\" class=\"empty\">\n        Aucune visite.\n    </div>\n    \n<style>\n    .visit-card {\n        background: var(--nr-dashboard-cardColor);\n        color: var(--nr-dashboard-textColor);\n        border-radius: 10px;\n        padding: 14px;\n        margin-bottom: 12px;\n        border-left: 4px solid #4caf50;\n    }\n\n    .header {\n        display: flex;\n        justify-content: space-between;\n        align-items: center;\n        margin-bottom: 10px;\n        font-weight: bold;\n    }\n\n    .table {\n        font-size: 18px;\n    }\n\n    .status {\n        background: #4caf50;\n        color: white;\n        padding: 3px 10px;\n        border-radius: 20px;\n        font-size: 12px;\n    }\n\n    .line {\n        display: flex;\n        justify-content: space-between;\n        margin: 6px 0;\n        font-size: 14px;\n        word-break: break-all;\n    }\n\n    .empty {\n        text-align: center;\n        color: #888;\n        padding: 20px;\n    }\n</style>",
        "storeOutMessages": true,
        "fwdInMessages": true,
        "resendOnRefresh": true,
