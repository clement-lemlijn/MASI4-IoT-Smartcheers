  {
    "id": "d16764129206a2dc",
    "type": "function",
    "z": "accb7e149dc8d74a",
    "name": "function 32",
    "func": "// Conversion du payload MQTT\nlet data = msg.payload.toString().trim();\n\n// Device:esp32h2-102,Temp:22.0,Hum:50.0,Son:705\n\nlet sensor = {};\ndata.split(\",\").forEach(part => {\n    let [key, value] = part.split(\":\");\n    if (!key || !value) {\n        return;\n    }\n    key = key.trim();\n    value = value.trim();\n    switch (key) {\n\n        case \"Device\":\n            sensor.deviceId = value;\n            break;\n\n        case \"Temp\":\n            sensor.temperature = Number(value);\n            break;\n\n        case \"Hum\":\n            sensor.humidity = Number(value);\n            break;\n\n        case \"Son\":\n            sensor.sound = Number(value);\n            break;\n    }\n});\n\nmsg.payload = sensor;\n\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 390,
    "y": 340,
