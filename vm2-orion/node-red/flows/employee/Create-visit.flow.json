    {
        "id": "cec4604e40f50ed9",
        "type": "function",
        "z": "790d1ef794ba3c12",
        "name": "select clients",
        "func": "const pipeline = [\n    {\n        $match: {\n            banni: false\n        }\n    },\n    {\n        $lookup: {\n            from: \"visites\",\n            let: { clientId: \"$_id\" },\n            pipeline: [\n                {\n                    $match: {\n                        $expr: {\n                            $and: [\n                                { $eq: [\"$clientId\", \"$$clientId\"] },\n                                { $eq: [\"$statut\", \"ouverte\"] }\n                            ]\n                        }\n                    }\n                }\n            ],\n            as: \"visitesActives\"\n        }\n    },\n    {\n        $match: {\n            visitesActives: {\n                $size: 0\n            }\n        }\n    },\n    {\n        $project: {\n            visitesActives: 0\n        }\n    }\n];\n\nmsg.payload = [pipeline];\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
