    {
        "id": "c4f943f3fdae1d68",
        "type": "function",
        "z": "790d1ef794ba3c12",
        "name": "build_visite",
        "func": "const clientId = flow.get('visite_clientId');\nconst badgeId = flow.get('visite_badgeId');\nconst tableNumero = flow.get('visite_tableNumero');\n\nif (!clientId || !badgeId || !tableNumero) {\n    node.warn(\"Formulaire incomplet\");\n    return null;\n}\n\n// Génère un token unique\nconst crypto = global.get('crypto') || require('crypto');\nconst token = crypto.randomBytes(4).toString('hex');\n\nconst visite = {\n    badgeId: String(badgeId),\n    clientId: String(clientId),\n    token: token,\n    tableNumero: Number(tableNumero),\n    dateArrivee: new Date(),\n    dateDepart: null,\n    statut: \"ouverte\",\n    montantTotalVisite: 0,\n    paiement: null\n};\n\nmsg.payload = [visite];\nmsg.visitToken = token;\n\nflow.set('pending_badgeId', badgeId);\nmsg.pendingBadgeId = badgeId;\n\nflow.set('pending_tableNumero', Number(tableNumero));\nmsg.pendingTableNumero = Number(tableNumero);\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 530,
        "y": 480,
        "wires": [
            [
                "2e1b184ab833c728",
                "c3560d0259bf9d68",
                "fe5e313e9f20b0c1",
                "ea801ebe06da3acf"
            ]
        ]
    },
    {
        "id": "2e1b184ab833c728",
        "type": "function",
        "z": "790d1ef794ba3c12",
        "name": "function 24",
        "func": "const badgeId = msg.pendingBadgeId;\n\nmsg.payload = [\n    {\n        badgeUid: badgeId\n    },\n    {\n        $set: {\n            statut: \"attribue\"\n        }\n    }\n];\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
