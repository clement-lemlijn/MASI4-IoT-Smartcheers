        "func": "const badgeId = flow.get('pending_badgeId');\n\nmsg.query = {\n    badgeUid: badgeId\n};\n\nmsg.payload = {\n    $set: {\n        statut: \"attribue\"\n    }\n};\n\nreturn msg;",
