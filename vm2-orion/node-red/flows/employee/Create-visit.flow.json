    {
        "id": "c4f943f3fdae1d68",
        "type": "function",
        "z": "790d1ef794ba3c12",
        "name": "build_visite",
        "func": "const clientId = flow.get('visite_clientId');\nconst badgeId = flow.get('visite_badgeId');\nconst tableNumero = flow.get('visite_tableNumero');\n\nif (!clientId || !badgeId || !tableNumero) {\n    node.warn(\"Formulaire incomplet\" + !clientId + !badgeId + !tableNumero);\n    return null;\n}\n\n// Génère un token unique pour cette visite (accès dashboard client)\nconst crypto = global.get('crypto') || require('crypto');\nconst token = crypto.randomBytes(4).toString('hex');\n\nmsg.payload = {\n    badgeId: String(badgeId),\n    clientId: String(clientId),\n    token: token,\n    tableNumero: Number(tableNumero),\n    dateArrivee: new Date(),\n    dateDepart: null,\n    statut: \"ouverte\",\n    montantTotalVisite: Number(0),\n    paiement: null\n};\n\nflow.set('pending_badgeId', badgeId);\nflow.set('pending_tableNumero', Number(tableNumero));\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 530,
        "y": 480,
        "wires": [
