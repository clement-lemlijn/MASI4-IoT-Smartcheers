    "order": 4,
    "width": "6",
    "height": "4",
    "format": "<div style=\"\n    display: flex;\n    justify-content: center;\n    align-items: center;\n\">\n\n    <img\n        id=\"camera\"\n        src=\"http://192.168.1.10:5000/camera/d3775d49\"\n        width=\"200\"\n        style=\"display:none;\"\n    >\n\n    <img\n        id=\"photo\"\n        width=\"200\"\n        style=\"display:none;\"\n    >\n\n</div>\n\n\n<script>\n    (function(scope) {\n\n    scope.$watch('msg', function(msg) {\n\n        if(!msg)\n            return;\n\n\n        if(msg.payload === \"show\") {\n\n            document.getElementById(\"camera\").style.display = \"block\";\n            document.getElementById(\"photo\").style.display = \"none\";\n\n        }\n\n\n        if(msg.payload === \"hide\") {\n\n            document.getElementById(\"camera\").style.display = \"none\";\n            document.getElementById(\"photo\").style.display = \"none\";\n\n        }\n\n\n        if(msg.payload === \"photo\") {\n\n            document.getElementById(\"camera\").style.display = \"none\";\n\n            document.getElementById(\"photo\").src =\n                \"http://192.168.1.10:5000/take/d3775d49?\"\n                + Date.now();\n\n            document.getElementById(\"photo\").style.display = \"block\";\n\n        }\n\n\n    });\n\n\n})(scope);\n\n</script>",
