  {
    "id": "699192e7599e7111",
    "type": "function",
    "z": "19d04a0260af23f7",
    "name": "prep query",
    "func": "// filtre sur les items disponibles du menu client\n\nmsg.payload = [\n    {\n        disponible: true\n    }\n];\n\nreturn msg;",
