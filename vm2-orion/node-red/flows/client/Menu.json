  {
    "id": "07a8f9c61187fe8b",
    "type": "function",
    "z": "19d04a0260af23f7",
    "name": "group by categorie",
    "func": "const items = msg.payload || [];\n\nconst grouped = {};\nitems.forEach(function(item) {\n    const cat = item.categorie || \"Autres\";\n    if (!grouped[cat]) grouped[cat] = [];\n    grouped[cat].push({\n        nom: item.nom,\n        prix: item.prix,\n        description: item.description || \"\",\n        imageUrl: item.imageUrl || \"\"\n    });\n});\n\nmsg.payload = grouped;\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 790,
    "y": 190,
    "wires": [
      [
        "4ceb279af67ac7d8"
      ]
    ]
  },
  {
    "id": "4ceb279af67ac7d8",
    "type": "ui_template",
    "z": "19d04a0260af23f7",
    "group": "5c8ad1cd9777c881",
    "name": "Affichage menu",
    "order": 2,
    "width": "6",
    "height": "10",
    "format": "<div style=\"font-family: sans-serif;\">\n  <div ng-repeat=\"(categorie, articles) in msg.payload\">\n    <h2>{{categorie}}</h2>\n    <div ng-repeat=\"item in articles\" style=\"display:flex; align-items:center; gap:12px; border-bottom:1px solid #eee; padding:8px 0;\">\n      <img ng-if=\"item.imageUrl\" ng-src=\"{{item.imageUrl}}\" style=\"width:56px; height:56px; object-fit:cover; border-radius:8px; flex-shrink:0;\">\n      <div style=\"flex:1;\">\n        <b>{{item.nom}}</b>\n        <div style=\"font-size:0.85em; color:#666;\" ng-if=\"item.description\">{{item.description}}</div>\n      </div>\n      <div style=\"white-space:nowrap;\">{{item.prix}} EUR</div>\n    </div>\n  </div>\n</div>",
    "storeOutMessages": true,
    "fwdInMessages": false,
    "resendOnRefresh": false,
