  {
    "id": "26f5ea29585e7b37",
    "type": "function",
    "z": "c1de5e0fa5cd6af2",
    "name": "prep aggregate",
    "func": "var visitId = global.get(\"visitId\");\n\nmsg.payload = [\n    { $match: { _id: visitId } },\n    {\n        $lookup: {\n            from: \"commandes\",\n            localField: \"_id\",\n            foreignField: \"visiteId\",\n            as: \"commandes\"\n        }\n    },\n    {\n        $project: {\n            tableNumero: 1,\n            montantTotalVisite: 1,\n            commandes: 1\n        }\n    }\n];\n\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 380,
    "y": 190,
    "wires": [
      [
        "038a9ba4424067bf"
      ]
    ]
  },
  {
    "id": "038a9ba4424067bf",
    "type": "mongodb in",
    "z": "c1de5e0fa5cd6af2",
    "mongodb": "3cfdbcebb776dcac",
    "name": "get visite",
    "collection": "visites",
    "operation": "aggregate",
    "x": 570,
    "y": 190,
    "wires": [
      [
        "fe2e88050bd41ae1"
      ]
    ]
  },
  {
    "id": "fe2e88050bd41ae1",
    "type": "function",
    "z": "c1de5e0fa5cd6af2",
    "name": "build payload",
    "func": "const visite = msg.payload[0];\n\nif (!visite) {\n    msg.payload = { error: true, message: \"Aucune visite en cours.\" };\n    return msg;\n}\n\nmsg.payload = {\n    total: visite.montantTotalVisite || 0,\n    commandes: (visite.commandes || []).map(function(cmd) {\n        return {\n            statut: cmd.statut || \"En attente\",\n            articles: cmd.articles || []\n        };\n    })\n};\n\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 780,
    "y": 190,
    "wires": [
      [
        "96ec718bf54823ca"
      ]
    ]
  },
  {
    "id": "96ec718bf54823ca",
    "type": "ui_template",
    "z": "c1de5e0fa5cd6af2",
    "group": "b78f98b223ec2640",
    "name": "Affichage depenses",
    "order": 2,
    "width": 0,
    "height": 0,
    "format": "<div style=\"font-family: sans-serif;\">\n  <div ng-if=\"msg.payload.error\">\n    <p>{{msg.payload.message}}</p>\n  </div>\n  <div ng-if=\"!msg.payload.error\">\n    <h2>Total : {{msg.payload.total}} EUR</h2>\n    <div ng-repeat=\"cmd in msg.payload.commandes\" style=\"border-top:1px solid #ddd; margin-top:10px; padding-top:10px;\">\n      <p>Statut : <b>{{cmd.statut}}</b></p>\n      <ul>\n        <li ng-repeat=\"a in cmd.articles\">{{a}}</li>\n      </ul>\n    </div>\n  </div>\n</div>",
    "storeOutMessages": true,
    "fwdInMessages": false,
    "resendOnRefresh": false,
