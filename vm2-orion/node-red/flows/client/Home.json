    {
        "id": "e314cbd2ecc6c896",
        "type": "function",
        "z": "296759a92d9f05a6",
        "name": "function 1",
        "func": "var visitId = global.get(\"visitId\");\n\nconst pipeline = [\n    { $match: { _id: visitId } },\n    {\n        $lookup: {\n            from: \"clients\",\n            localField: \"clientId\",\n            foreignField: \"_id\",\n            as: \"client\"\n        }\n    },\n    {\n        $project: {\n            tableNumero: 1,\n            montantTotalVisite: 1,\n            client: { $arrayElemAt: [\"$client\", 0] }\n        }\n    }\n];\n\nmsg.payload = [pipeline];\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 320,
