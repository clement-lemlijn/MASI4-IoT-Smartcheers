        "func": "const visiteId = flow.get(\"visiteId\");\n\nnode.warn(\"set \" + visiteId + \" to fermee\");\n\nmsg.query = {\n    _id: visiteId\n};\n\nmsg.payload = {\n    $set: {\n        statut: \"fermee\"\n    }\n};\n\nreturn msg;",
