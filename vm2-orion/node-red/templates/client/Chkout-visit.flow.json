    {
        "id": "7d0e550baa91f567",
        "type": "function",
        "z": "37ad7ff4acb2cba6",
        "name": "function 2",
        "func": "msg.payload = msg.payload.map(visite => {\n\n    const date = new Date(visite.dateArrivee)\n        .toLocaleString(\"fr-BE\", {\n            hour: \"2-digit\",\n            minute: \"2-digit\"\n        });\n\n    visite.affichage =\n        `${date} - Table ${visite.tableNumero} - ${visite.statut}`;\n\n    return visite;\n\n});\n\nmsg.options = msg.payload.map(visite => {\n    return { [visite.affichage]: visite };\n});\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
